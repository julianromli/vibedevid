{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibedevid",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  // Hourly: delete expired auth sessions/OTPs (server/plugins/auth-cleanup-cron.ts).
  // Runs outside page requests so Neon is not woken per isolate. Keep in sync with AUTH_CLEANUP_CRON.
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "EMAIL_FROM": "noreply@vibedeveloper.id",
    // Exact addresses (comma-separated) that may sign up outside the email domain list.
    "NEW_ACCOUNT_ALLOWED_EMAILS": "faiz@mail.grokbot.com",
    // Preview URLs of this worker (<branch>-vibedevid...) trust their own origin for auth.
    "AUTH_PREVIEW_HOST_SUFFIX": "-vibedevid.faizintifada.workers.dev",
  },
}
