{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibedevid",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  // Postgres 17 on the VPS (db.vibedeveloper.id, behind Cloudflare Tunnel + Access), via Hyperdrive.
  // PLACEHOLDER id: replace with the real id from `wrangler hyperdrive create` before merging.
  // A deploy with this placeholder fails, so prod keeps the previous version.
  // Local dev (`bun run dev`) and scripts use DATABASE_URL. Under `wrangler dev`, set
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "EMAIL_FROM": "noreply@vibedeveloper.id",
    // Exact addresses (comma-separated) that may sign up outside the email domain list.
    "NEW_ACCOUNT_ALLOWED_EMAILS": "faiz@mail.grokbot.com",
    // Preview URLs of this worker (<branch>-vibedevid...) trust their own origin for auth.
    "AUTH_PREVIEW_HOST_SUFFIX": "-vibedevid.faizintifada.workers.dev",
  },
}
