{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibedevid",
  "main": ".output/server/index.mjs",
  // Nitro already bundles the server. Upload its modules as-is (Nitro's own default for
  // cloudflare_module). Re-bundling with esbuild added `__name()` wrappers to functions,
  // which broke next-themes' inline script (serialized with fn.toString()) in the browser.
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "compatibility_date": "2024-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  // Postgres 17 on the VPS (db.vibedeveloper.id, behind Cloudflare Tunnel + Access), via Hyperdrive.
  // Hyperdrive config with caching disabled (reads must see writes immediately).
  // Local dev (`bun run dev`) and scripts use DATABASE_URL. Under `wrangler dev`, set
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0bdd0350694b41589bbe89fa801db883",
    },
  ],
  // Run the Worker next to the DB (VPS in Jakarta) instead of at the visitor's edge colo.
  // Each request makes several serial DB round trips; Indonesian traffic was landing in
  // SJC/MRS/CDG, ~200 ms per round trip. Revert by deleting this block.
  "placement": {
    "region": "gcp:asia-southeast2",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "EMAIL_FROM": "noreply@vibedeveloper.id",
    // Exact addresses (comma-separated) that may sign up outside the email domain list.
    "NEW_ACCOUNT_ALLOWED_EMAILS": "faiz@mail.grokbot.com",
    // Preview URLs of this worker (<branch>-vibedevid...) trust their own origin for auth.
    "AUTH_PREVIEW_HOST_SUFFIX": "-vibedevid.faizintifada.workers.dev",
  },
}
