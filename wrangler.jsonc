{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibedevid",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "EMAIL_FROM": "noreply@vibedeveloper.id",
    // Exact addresses (comma-separated) that may sign up outside the email domain list.
    "NEW_ACCOUNT_ALLOWED_EMAILS": "faiz@mail.grokbot.com",
  },
}
